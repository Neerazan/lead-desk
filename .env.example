# Database Configuration
POSTGRES_USER=leaddesk
POSTGRES_PASSWORD=leaddesk_dev_secret
POSTGRES_DB=leaddesk
DATABASE_URL=postgresql://leaddesk:leaddesk_dev_secret@db:5432/leaddesk

# JWT & Authentication Configuration
# In production, set these to strong random 256-bit keys
JWT_SECRET=supersecretjwtkey_change_in_production_12345
ACCESS_TOKEN_SECRET_KEY=access_supersecret_change_in_production
REFRESH_TOKEN_SECRET_KEY=refresh_supersecret_change_in_production
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
SECURE_COOKIES=false

# Frontend Configuration
FRONTEND_ORIGIN=http://localhost:3000
INTERNAL_API_URL=http://backend:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
